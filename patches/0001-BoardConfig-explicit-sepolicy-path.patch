From: j8-a10 <noreply@example.com>
Subject: [PATCH 1/2] BoardConfig: register device sepolicy by explicit path

Android 10 merges every BOARD_SEPOLICY_DIRS entry into the file contexts used
when creating the system image. $(LOCAL_PATH) is an Android.mk variable; using
it in BoardConfig.mk is fragile and, when it does not resolve, the device's own
file_contexts entries are silently dropped from the merge. e2fsdroid then fails
with:

  set_selinux_xattr: No such file or directory searching for label "/firmware"

because selabel_lookup() finds no matching rule at all.

Use the explicit path, and terminate the file with a newline.
---
diff --git a/BoardConfig.mk b/BoardConfig.mk
index 57827b8..c96c890 100644
--- a/BoardConfig.mk
+++ b/BoardConfig.mk
@@ -232,7 +232,7 @@ TARGET_PROVIDES_QTI_TELEPHONY_JAR := true
 
 # SELinux
 include device/qcom/sepolicy-legacy-um/sepolicy.mk
-BOARD_SEPOLICY_DIRS += $(LOCAL_PATH)/sepolicy
+BOARD_SEPOLICY_DIRS += device/samsung/j8y18lte/sepolicy
 
 # Treble
 BOARD_PROPERTY_OVERRIDES_SPLIT_ENABLED := true
@@ -262,4 +262,4 @@ WIFI_DRIVER_FW_PATH_AP := "ap"
 WIFI_DRIVER_FW_PATH_STA := "sta"
 WPA_SUPPLICANT_VERSION := VER_0_8_X
 TARGET_DISABLE_WCNSS_CONFIG_COPY := true
-WIFI_HIDL_FEATURE_DISABLE_AP_MAC_RANDOMIZATION := true
\ No newline at end of file
+WIFI_HIDL_FEATURE_DISABLE_AP_MAC_RANDOMIZATION := true
